{
	"name": "sftp_pipeline",
	"properties": {
		"activities": [
			{
				"name": "copy_sqldata_blobstorage",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[dbo].[adf_sampledata]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": "PreserveHierarchy",
							"metadata": [
								{
									"name": "filemeta",
									"value": "1"
								}
							]
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"maxRowsPerFile": 500,
							"fileNamePrefix": {
								"value": "datadump_@{pipeline().TriggerTime}",
								"type": "Expression"
							},
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSQL",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "azureBlob_sftp",
						"type": "DatasetReference",
						"parameters": {
							"FileName": {
								"value": "@''",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Get_Blob_files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "copy_sqldata_blobstorage",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "azureBlob_sftp",
						"type": "DatasetReference",
						"parameters": {
							"FileName": {
								"value": "@''",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Get_Blob_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(activity('Get_Blob_files').output.childItems), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Execute PipelineSHIR",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "Pl_SHIR_Process",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"FileList": {
										"value": "@activity('Get_Blob_files').output.childItems",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Resource_Group_Name": {
				"type": "string",
				"defaultValue": "cplybc_vnet_rg"
			},
			"VM_Name": {
				"type": "string",
				"defaultValue": "vmadfshir"
			},
			"SHIR_Name": {
				"type": "string"
			},
			"SubID": {
				"type": "string",
				"defaultValue": "6960d20f-4d42-4990-b3b1-890c7bb30bb6"
			}
		},
		"annotations": []
	}
}